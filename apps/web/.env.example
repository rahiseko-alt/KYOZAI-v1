# apps/web 環境変数の宣言的テンプレート（12-Factor III）。
# 実際の値はコミットしない（.gitignore で .env / .env.* を除外、本ファイルのみ許可）。
# 本番の実シークレットは Vercel の Environment Variables で注入する。
#
# キーを追加したら、ここにも名前とダミー値・用途を必ず追記すること
# （AGENTS.md「公開前提（ポートフォリオ）」1）。
#
# 教材生成・自然文修正で利用する。実値はローカルの .env.local または Vercel へ設定する。
OPENAI_API_KEY=replace-with-server-side-key

# Gemini画像モデルを選択した生成で利用する。実値はサーバー側だけに設定する。
GEMINI_API_KEY=replace-with-server-side-key

# 画像生成grantの署名専用。32バイト以上。本番のAPIキー等を流用しない。
KYOZAI_RENDER_GRANT_SECRET=replace-with-at-least-32-byte-random-secret

# grant鍵を交換するときの検証専用旧鍵。移行完了後に削除する。
KYOZAI_RENDER_GRANT_SECRET_PREVIOUS=

# レート制限の利用者識別を不可逆化するHMAC専用鍵。32バイト以上。
KYOZAI_RATE_LIMIT_ID_SECRET=replace-with-at-least-32-byte-random-secret

# Upstash Redis REST接続。Preview/Productionの分散レート制限に必須。
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint
UPSTASH_REDIS_REST_TOKEN=replace-with-server-side-token

# 未指定時も gpt-5.5。教材構成・修正・画像QAに利用する。
OPENAI_MODEL=gpt-5.5

# E2E 専用。1 のとき外部APIを呼ばず固定教材を返す。本番には設定しない。
KYOZAI_E2E_MODE=0

# Skill同等工程のpipeline。認証済みPreviewとローカル検証だけで1にする。Productionはコード上で常に生成を拒否する。
PROCESS_PARITY_PIPELINE_ENABLED=0

# 永続job API。Supabase migrationとprivate bucket、Authを設定したPreviewだけで1にする。Productionはコード上で常に404。
KYOZAI_ASYNC_JOBS_ENABLED=0

# G1故障注入専用。両方をPreviewへ設定した間だけ指定境界で停止する。Productionでは常に無効。
KYOZAI_G1_FAULT_INJECTION_ENABLED=0
KYOZAI_G1_FAULT_POINT=provider_response_received

# Supabase Auth / Postgres / private Storage のプロジェクトURL。ブラウザへ公開される接続先。
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co

# Supabase の Publishable key。提供元が公開配布用と定めるキーだけを設定する。
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Supabase service_role key。job作成、署名付きupload、Workflowだけで使用し、ブラウザへ渡さない。
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-key

# Supabase schedulerとVercelの内部dispatch認証。32バイト以上のランダム値を、両者へ直接設定する。
# Supabase Vaultでは `kyozai_scheduler_cron_secret` の名前で保存する。公開Productionではroute自体が常に404となる。
CRON_SECRET=replace-with-at-least-32-byte-random-secret

# Git連携を使わない手動Vercel配備で、prod-smokeが配備元commitを照合する公開メタデータ。秘密値ではない。
KYOZAI_DEPLOY_COMMIT_SHA=local
