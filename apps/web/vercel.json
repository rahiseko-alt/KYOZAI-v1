{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack pnpm@10.33.0 install --no-frozen-lockfile --ignore-workspace --config.optional=true",
  "buildCommand": "corepack pnpm@10.33.0 build",
  "outputDirectory": ".next",
  "regions": ["hnd1"],
  "crons": [
    {
      "path": "/api/internal/jobs/dispatch",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/jobs/cleanup",
      "schedule": "17 */6 * * *"
    }
  ]
}
