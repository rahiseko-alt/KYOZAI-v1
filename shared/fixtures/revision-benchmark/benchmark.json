{
  "version": "1.0.0",
  "purpose": "Deterministic benchmark for KYOZAI Revise Phase 0 revision planning and validation.",
  "categories": [
    {
      "id": "proper-noun-and-typo",
      "label": "固有文言・誤字",
      "cases": [
        {"id":"R001","instruction":"1枚目の『KYOZAI』を『KYOZAI Revise』に変更して。","operation":"text.replace","scope":{"slides":[1],"fields":["title"]},"must_preserve":["slide_2_to_end.text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.1.title equals KYOZAI Revise","only slide.1 title is patched","artifact_links remain valid"],"stability":"strict"},
        {"id":"R002","instruction":"3枚目の『受講者』を『受講対象者』に直して。","operation":"text.replace","scope":{"slides":[3],"fields":["body_text"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.3 contains 受講対象者","slide.3 no longer contains 受講者 as the replaced label","only slide.3 text changes"],"stability":"strict"},
        {"id":"R003","instruction":"2枚目の『コンプライアンス』を『コンプライアンス研修』に変更してください。","operation":"text.replace","scope":{"slides":[2],"fields":["heading"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.2.heading equals コンプライアンス研修","no non-target slide changes"],"stability":"strict"},
        {"id":"R004","instruction":"4枚目の『情報漏えい』の表記を『情報漏洩』に統一して。","operation":"text.replace","scope":{"slides":[4],"fields":["body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash"],"expected_assertions":["slide.4 text uses 情報漏洩","slide.4 speaker notes use 情報漏洩","non-target artifacts are unchanged"],"stability":"strict"},
        {"id":"R005","instruction":"5枚目の『セキュリティポリシー』を『情報セキュリティ方針』に変えて。","operation":"text.replace","scope":{"slides":[5],"fields":["title","body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash"],"expected_assertions":["slide.5 replaces all requested occurrences","slide.5 duration is recalculated","non-target slide hashes match"],"stability":"strict"},
        {"id":"R006","instruction":"2枚目の『社内規定』を『社内規程』に修正して。","operation":"text.replace","scope":{"slides":[2],"fields":["body_text"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.2 contains 社内規程","slide.2 does not contain the corrected occurrence of 社内規定","no visual regeneration is requested"],"stability":"strict"},
        {"id":"R007","instruction":"表紙の『新入社員向け』を『全社員向け』に変更してください。","operation":"text.replace","scope":{"slides":[1],"fields":["subtitle"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.1.subtitle contains 全社員向け","only slide.1 subtitle changes"],"stability":"strict"},
        {"id":"R008","instruction":"6枚目の『パスワード』を『パスワード管理』に直して。","operation":"text.replace","scope":{"slides":[6],"fields":["heading"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.6.heading equals パスワード管理","target layout coordinates are preserved"],"stability":"strict"},
        {"id":"R009","instruction":"7枚目の『確認しましょう』を『確認してください』に変更して。","operation":"text.replace","scope":{"slides":[7],"fields":["callout_text"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash"],"expected_assertions":["slide.7.callout equals 確認してください","no unrelated wording changes"],"stability":"strict"},
        {"id":"R010","instruction":"8枚目の『持ち出し』を『社外持ち出し』に修正してください。","operation":"text.replace","scope":{"slides":[8],"fields":["body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash"],"expected_assertions":["slide.8 display and notes use 社外持ち出し","only declared fields are updated"],"stability":"strict"}
      ]
    },
    {
      "id": "shorten-audience-tone",
      "label": "短縮・対象者・トーン",
      "cases": [
        {"id":"R011","instruction":"3枚目の見出しを意味を変えずに半分くらいの長さにして。","operation":"text.rewrite","scope":{"slides":[3],"fields":["heading"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash","slide.3.claim_ids"],"expected_assertions":["slide.3.heading length is at most 60 percent of original","slide.3.claim_ids are unchanged","no other slide text changes"],"stability":"bounded"},
        {"id":"R012","instruction":"2枚目の説明文を80文字以内に要約して。","operation":"text.rewrite","scope":{"slides":[2],"fields":["body_text"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash","slide.2.claim_ids"],"expected_assertions":["slide.2.body_text length is at most 80 Japanese characters","slide.2 claim references are retained","no non-target artifact changes"],"stability":"bounded"},
        {"id":"R013","instruction":"全体をAI初心者にも分かる表現に直して。","operation":"text.rewrite","scope":{"slides":"all","fields":["title","body_text","speaker_notes"]},"must_preserve":["all.slide_order","all.claim_ids","all.design_profile_hash"],"expected_assertions":["all slides receive a rewrite plan","technical terms are explained or replaced","design profile is unchanged"],"stability":"bounded"},
        {"id":"R014","instruction":"この教材を管理職向けの表現に変更してください。","operation":"text.rewrite","scope":{"slides":"all","fields":["title","body_text","speaker_notes"]},"must_preserve":["all.slide_order","all.claim_ids","all.design_profile_hash"],"expected_assertions":["audience is recorded as managers","manager decision context is reflected","source claims remain traceable"],"stability":"bounded"},
        {"id":"R015","instruction":"4枚目だけ、命令口調ではなく丁寧な案内文にして。","operation":"text.rewrite","scope":{"slides":[4],"fields":["body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","slide.4.claim_ids"],"expected_assertions":["slide.4 wording is polite","slide.4 claims are unchanged","no non-target text changes"],"stability":"bounded"},
        {"id":"R016","instruction":"5枚目を現場スタッフ向けに、専門用語を減らして書き直して。","operation":"text.rewrite","scope":{"slides":[5],"fields":["body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","slide.5.claim_ids"],"expected_assertions":["slide.5 uses plain language","slide.5 preserves source-backed claims","only slide.5 and linked notes change"],"stability":"bounded"},
        {"id":"R017","instruction":"6枚目の説明を30秒で読める量に短くして。","operation":"text.rewrite","scope":{"slides":[6],"fields":["body_text","speaker_notes"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","slide.6.claim_ids"],"expected_assertions":["slide.6 speaker notes duration is at most 30 seconds","slide.6 claims remain","no non-target slides change"],"stability":"bounded"},
        {"id":"R018","instruction":"表紙と導入を、堅すぎない親しみやすいトーンにして。","operation":"text.rewrite","scope":{"slides":[1,2],"fields":["title","subtitle","body_text","speaker_notes"]},"must_preserve":["slides.3_to_end.text_hash","slides.3_to_end.script_hash","all.layout_hash"],"expected_assertions":["only slides.1 and 2 plus linked notes change","tone is conversational but professional","slide order remains unchanged"],"stability":"bounded"},
        {"id":"R019","instruction":"7枚目の箇条書きを3項目にまとめて。","operation":"text.rewrite","scope":{"slides":[7],"fields":["body_text"]},"must_preserve":["all.other_text_hash","all.script_hash","all.layout_hash","slide.7.claim_ids"],"expected_assertions":["slide.7 has exactly 3 bullet items","all retained claims are source-traceable","no other slide text changes"],"stability":"bounded"},
        {"id":"R020","instruction":"全体を社内研修らしい、落ち着いた敬体に統一して。","operation":"text.rewrite","scope":{"slides":"all","fields":["body_text","speaker_notes"]},"must_preserve":["all.slide_order","all.claim_ids","all.design_profile_hash"],"expected_assertions":["all eligible text uses polite style","titles retain their meaning","design and structure are unchanged"],"stability":"bounded"}
      ]
    },
    {
      "id": "image-and-local-layout",
      "label": "画像・局所レイアウト",
      "cases": [
        {"id":"R021","instruction":"3枚目の画像だけ、飲食店の現場写真に変更して。","operation":"visual.replace-image","scope":{"slides":[3],"fields":["image"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","slides.1_to_2_and_4_to_end.image_hash"],"expected_assertions":["only slide.3 image asset changes","replacement image subject is restaurant workplace","slide.3 text and coordinates remain unchanged"],"stability":"strict"},
        {"id":"R022","instruction":"4枚目のイラストを、鍵とノートPCのイラストに差し替えて。","operation":"visual.replace-image","scope":{"slides":[4],"fields":["image"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.other_image_hash"],"expected_assertions":["only slide.4 image changes","replacement depicts a key and laptop","no text rewrite is planned"],"stability":"strict"},
        {"id":"R023","instruction":"2枚目の写真を人物の写らないオフィス風景に変えてください。","operation":"visual.replace-image","scope":{"slides":[2],"fields":["image"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.other_image_hash"],"expected_assertions":["only slide.2 image asset changes","replacement contains no identifiable person","all coordinates remain unchanged"],"stability":"strict"},
        {"id":"R024","instruction":"5枚目の図を、左から右へ流れる3段階の図解に変更して。","operation":"visual.relayout-slide","scope":{"slides":[5],"fields":["diagram","element_coordinates"]},"must_preserve":["all.text_hash","all.script_hash","slides.1_to_4_and_6_to_end.layout_hash","all.design_profile_hash"],"expected_assertions":["slide.5 diagram has 3 ordered stages","only slide.5 coordinates change","text content is unchanged"],"stability":"bounded"},
        {"id":"R025","instruction":"6枚目の見出しと本文が重なっているので、このスライドだけ直して。","operation":"visual.relayout-slide","scope":{"slides":[6],"fields":["element_coordinates"]},"must_preserve":["all.text_hash","all.script_hash","all.other_layout_hash","all.design_profile_hash"],"expected_assertions":["slide.6 has no text overlap","only slide.6 layout changes","all text hashes are unchanged"],"stability":"strict"},
        {"id":"R026","instruction":"7枚目の画像を小さくして、説明文の余白を増やして。","operation":"visual.relayout-slide","scope":{"slides":[7],"fields":["image_frame","element_coordinates"]},"must_preserve":["all.text_hash","all.script_hash","all.other_layout_hash","all.design_profile_hash"],"expected_assertions":["slide.7 image frame area decreases","slide.7 body text margin increases","non-target layouts are unchanged"],"stability":"bounded"},
        {"id":"R027","instruction":"8枚目のアイコンを盾のアイコンに差し替えて。","operation":"visual.replace-image","scope":{"slides":[8],"fields":["icon"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.other_image_hash"],"expected_assertions":["only slide.8 icon asset changes","replacement is a shield icon","no other artifacts change"],"stability":"strict"},
        {"id":"R028","instruction":"3枚目の図表を中央揃えにしてください。文章は変えないで。","operation":"visual.relayout-slide","scope":{"slides":[3],"fields":["chart_frame","element_coordinates"]},"must_preserve":["all.text_hash","all.script_hash","all.other_layout_hash","all.design_profile_hash"],"expected_assertions":["slide.3 chart center aligns to canvas","all text hashes are identical","only slide.3 layout changes"],"stability":"strict"},
        {"id":"R029","instruction":"4枚目だけ、注意喚起の画像を赤い警告標識のイラストにしてください。","operation":"visual.replace-image","scope":{"slides":[4],"fields":["image"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.other_image_hash"],"expected_assertions":["only slide.4 image asset changes","replacement visually communicates a red warning sign","text remains unchanged"],"stability":"strict"},
        {"id":"R030","instruction":"9枚目の表の列幅を調整して、文字切れをなくして。","operation":"visual.relayout-slide","scope":{"slides":[9],"fields":["table_columns","element_coordinates"]},"must_preserve":["all.text_hash","all.script_hash","all.other_layout_hash","all.design_profile_hash"],"expected_assertions":["slide.9 has no clipped table text","only slide.9 table geometry changes","all display strings are unchanged"],"stability":"strict"}
      ]
    },
    {
      "id": "add-remove-move",
      "label": "追加・削除・移動",
      "cases": [
        {"id":"R031","instruction":"5枚目を削除してください。","operation":"slide.remove","scope":{"slides":[5],"fields":["slide","speaker_notes","linked_artifacts"]},"must_preserve":["all.remaining_text_hash","all.remaining_script_hash","all.remaining_layout_hash","relative_order_of_remaining_slides"],"expected_assertions":["slide.5 is absent from new version","linked speaker notes are removed","remaining slides retain relative order"],"stability":"strict"},
        {"id":"R032","instruction":"6枚目を5枚目の前へ移動して。","operation":"slide.move","scope":{"slides":[5,6],"fields":["slide_order","artifact_references"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.slide_content_hash"],"expected_assertions":["slide previously numbered 6 precedes slide previously numbered 5","content hashes are unchanged","cross-artifact slide references are renumbered"],"stability":"strict"},
        {"id":"R033","instruction":"導入の次に、研修の到達目標を1枚追加してください。","operation":"slide.add","scope":{"insert_after":2,"fields":["new_slide","speaker_notes","slide_order","linked_artifacts"]},"must_preserve":["all.existing_text_hash","all.existing_script_hash","all.existing_layout_hash","relative_order_of_existing_slides"],"expected_assertions":["one new goal slide is inserted after slide.2","existing slide content hashes are unchanged","new slide has speaker notes and duration"],"stability":"bounded"},
        {"id":"R034","instruction":"最後に確認テストの案内スライドを追加して。","operation":"slide.add","scope":{"insert_after":"last","fields":["new_slide","speaker_notes","slide_order","linked_artifacts"]},"must_preserve":["all.existing_text_hash","all.existing_script_hash","all.existing_layout_hash"],"expected_assertions":["one new final slide is added","new slide announces a comprehension check","existing slides are unchanged"],"stability":"bounded"},
        {"id":"R035","instruction":"2枚目と3枚目を入れ替えてください。","operation":"slide.move","scope":{"slides":[2,3],"fields":["slide_order","artifact_references"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.slide_content_hash"],"expected_assertions":["original slide.3 precedes original slide.2","no slide content is rewritten","all references match new numbers"],"stability":"strict"},
        {"id":"R036","instruction":"重複している7枚目を削除して、他は変えないで。","operation":"slide.remove","scope":{"slides":[7],"fields":["slide","speaker_notes","linked_artifacts"]},"must_preserve":["all.remaining_text_hash","all.remaining_script_hash","all.remaining_layout_hash","relative_order_of_remaining_slides"],"expected_assertions":["only original slide.7 is removed","all remaining assets retain hashes","slide numbering is consistent"],"stability":"strict"},
        {"id":"R037","instruction":"注意事項の前に、具体例のスライドを1枚追加して。","operation":"slide.add","scope":{"insert_before":{"match":"注意事項"},"fields":["new_slide","speaker_notes","slide_order","linked_artifacts"]},"must_preserve":["all.existing_text_hash","all.existing_script_hash","all.existing_layout_hash","relative_order_of_existing_slides"],"expected_assertions":["one example slide is inserted before the caution slide","new slide is source-grounded or marked as illustrative","existing slide content is unchanged"],"stability":"bounded"},
        {"id":"R038","instruction":"まとめのスライドを最後から2番目に移動して。","operation":"slide.move","scope":{"slides":["match:まとめ"],"fields":["slide_order","artifact_references"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.slide_content_hash"],"expected_assertions":["summary slide has second-last position","all slide content hashes match before version","references are consistent"],"stability":"strict"},
        {"id":"R039","instruction":"目次スライドを削除してください。","operation":"slide.remove","scope":{"slides":["match:目次"],"fields":["slide","speaker_notes","linked_artifacts"]},"must_preserve":["all.remaining_text_hash","all.remaining_script_hash","all.remaining_layout_hash","relative_order_of_remaining_slides"],"expected_assertions":["the table-of-contents slide is removed","all remaining slide content is unchanged","duration total is recalculated"],"stability":"strict"},
        {"id":"R040","instruction":"表紙の次に『この研修で学ぶこと』というスライドを追加して。","operation":"slide.add","scope":{"insert_after":1,"fields":["new_slide","speaker_notes","slide_order","linked_artifacts"]},"must_preserve":["all.existing_text_hash","all.existing_script_hash","all.existing_layout_hash","relative_order_of_existing_slides"],"expected_assertions":["new agenda slide is second","new slide lists learning outcomes","existing slide hashes are unchanged"],"stability":"bounded"}
      ]
    },
    {
      "id": "source-correction-and-deck-design",
      "label": "根拠訂正・全体デザイン",
      "cases": [
        {"id":"R041","instruction":"3枚目の『事故は毎年30%増加』は元資料に根拠がないので削除して。","operation":"source.correct","scope":{"slides":[3],"fields":["claim","body_text","speaker_notes","source_references"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","all.other_claim_ids"],"expected_assertions":["unsupported claim is removed","slide.3 source references no longer support removed claim","all unrelated claims remain unchanged"],"stability":"strict"},
        {"id":"R042","instruction":"4枚目の法令名を、元資料にある正式名称へ訂正してください。","operation":"source.correct","scope":{"slides":[4],"fields":["claim","body_text","speaker_notes","source_references"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","all.other_claim_ids"],"expected_assertions":["slide.4 uses the source-recorded formal law name","citation points to source evidence","non-target artifacts are unchanged"],"stability":"strict"},
        {"id":"R043","instruction":"5枚目の数値を、添付資料の最新値に更新して。","operation":"source.correct","scope":{"slides":[5],"fields":["claim","body_text","speaker_notes","source_references"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","all.other_claim_ids"],"expected_assertions":["slide.5 value equals latest source value","updated citation is traceable","only linked target content changes"],"stability":"strict"},
        {"id":"R044","instruction":"6枚目の事例は根拠資料にないため削除し、確認済みの説明だけ残して。","operation":"source.correct","scope":{"slides":[6],"fields":["claim","body_text","speaker_notes","source_references"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","all.other_claim_ids"],"expected_assertions":["unsupported example is absent","remaining claims retain valid citations","non-target slides are unchanged"],"stability":"strict"},
        {"id":"R045","instruction":"全体の青を少し濃くしてください。文章とレイアウトは変えないで。","operation":"visual.restyle-deck","scope":{"slides":"all","fields":["color_tokens"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.image_hash"],"expected_assertions":["primary blue token changes to a darker value","all strings and coordinates are identical","no image asset is regenerated"],"stability":"strict"},
        {"id":"R046","instruction":"教材全体を白背景と濃紺文字の見やすい配色に統一して。内容は変えないで。","operation":"visual.restyle-deck","scope":{"slides":"all","fields":["color_tokens","background_tokens","typography_color"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.image_hash"],"expected_assertions":["deck uses white background and dark navy text tokens","all text and geometry hashes match","contrast validation passes"],"stability":"strict"},
        {"id":"R047","instruction":"7枚目の出典を元資料の該当ページに差し替えてください。","operation":"source.correct","scope":{"slides":[7],"fields":["source_references"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.claim_ids"],"expected_assertions":["slide.7 citation targets the requested source page","display content is unchanged","all other citations are unchanged"],"stability":"strict"},
        {"id":"R048","instruction":"全体のアクセントカラーを緑に変更して。文章、画像、レイアウトはそのまま。","operation":"visual.restyle-deck","scope":{"slides":"all","fields":["accent_color_tokens"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.image_hash"],"expected_assertions":["accent token family is green","all content and assets retain hashes","only declared design tokens change"],"stability":"strict"},
        {"id":"R049","instruction":"8枚目の『必ず安全です』は根拠過剰なので、『安全を確認してください』に訂正して。","operation":"source.correct","scope":{"slides":[8],"fields":["claim","body_text","speaker_notes","source_references"]},"must_preserve":["all.other_text_hash","all.other_script_hash","all.layout_hash","all.other_claim_ids"],"expected_assertions":["overstated claim is replaced with supported wording","slide.8 citation remains valid","non-target artifacts are unchanged"],"stability":"strict"},
        {"id":"R050","instruction":"全体をプロジェクターで読みやすい高コントラスト配色にしてください。文章と配置は変えないで。","operation":"visual.restyle-deck","scope":{"slides":"all","fields":["color_tokens","background_tokens","typography_color"]},"must_preserve":["all.text_hash","all.script_hash","all.layout_hash","all.image_hash"],"expected_assertions":["contrast validation meets configured threshold","all text, layout, and image hashes are unchanged","only deck design tokens change"],"stability":"strict"}
      ]
    }
  ]
}
