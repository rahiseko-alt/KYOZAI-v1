{
  "name": "codex-slide-maker",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "audit": "pnpm audit --audit-level moderate",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:process": "node scripts/validate-process-contract.mjs",
    "validate:revise": "node scripts/validate-revision-benchmark.mjs && node --test .agents/skills/kyozai-revise/scripts/validate_revision.test.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "typescript": "^7.0.2"
  }
}
